APP_NAME="Commerinity Pro"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_CLIENT_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
OTP_TTL_MINUTES=15

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=commerinity_pro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Razorpay (Payment)
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX (Payout)
RAZORPAY_X_KEY=
RAZORPAY_X_SECRET=
RAZORPAY_X_WEBHOOK_SECRET=
RAZORPAY_X_SOURCE_ACCOUNT=

# Cashfree (Payment / Payout)
CASH_FREE_PAYMENT_KEY=
CASH_FREE_PAYMENT_SECRET=
# true = sandbox, false = production
CASH_FREE_PAYMENT_SANDBOX=true
CASH_FREE_PAYMENT_WEBHOOK=
CASH_FREE_PAYOUT_KEY=
CASH_FREE_PAYOUT_SECRET=
CASH_FREE_PAYOUT_WEBHOOK=

# SMS (Fast2SMS / DLT)
SMS_PROVIDER=fast2sms
FAST2SMS=
SMS_DLT_SMS=true
SMS_DEMO_MODE=false

# Web Push (VAPID)
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PEM_FILE=

# Telescope MCP
TELESCOPE_MCP_ENABLED=false
TELESCOPE_MCP_PATH=telescope-mcp
