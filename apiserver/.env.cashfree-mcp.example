# Cashfree MCP Server Configuration
# Copy this to .env and fill in your Cashfree credentials
# Get these from: https://merchant.cashfree.com/settings/api-keys

# ============================================
# CASHFREE PAYMENT GATEWAY (Incoming Payments)
# ============================================
# Get from: Developer Tools > API Keys > Payment Gateway
CASHFREE_PG_APP_ID=your_payment_gateway_client_id
CASHFREE_PG_APP_SECRET=your_payment_gateway_client_secret

# ============================================
# CASHFREE PAYOUTS (Outgoing Payments)
# ============================================
# Get from: Payouts > Settings > API Keys
CASHFREE_PAYOUTS_APP_ID=your_payouts_client_id
CASHFREE_PAYOUTS_APP_SECRET=your_payouts_client_secret

# ============================================
# ENVIRONMENT
# ============================================
# sandbox - for testing (money won't be deducted)
# production - for live transactions
CASHFREE_ENV=sandbox
